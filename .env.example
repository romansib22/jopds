# Настройки сервера
SERVER_PORT=8080

# Настройки базы данных (MariaDB)
# permitMysqlScheme — разрешает драйверу MariaDB принимать схему jdbc:mysql://
DATASOURCE_URL=jdbc:mysql://localhost:3306/jopds?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true&permitMysqlScheme
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=root

# Настройки INPX
INPX_FILE_PATH=/usr/books/fb2_local.inpx
INPX_BOOK_DIRECTORY=/usr/books

# Настройки администратора
ADMIN_DEFAULT_PASSWORD=admin
